#include <iostream>
using namespace std;

template<class T>
class vector {
    T* v;           // Pointer to store the dynamic array
    int size;       // Size of the vector

public:
    // Constructor to initialize vector of given size with 0
    vector(int m) {
        size = m;
        v = new T[size];
        for (int i = 0; i < size; i++) {
            v[i] = 0; // Initialize all elements to 0
        }
    }

    // Constructor to initialize vector from an array
    vector(T* a, int m) {
        size = m;
        v = new T[size];
        for (int i = 0; i < size; i++) {
            v[i] = a[i]; // Copy elements from array
        }
    }

    // Operator overloading to compute dot product of two vectors
    T operator*(vector& y) {
        T sum = 0;
        for (int i = 0; i < size; i++) {
            sum += v[i] * y.v[i];
        }
        return sum;
    }

    // Destructor to release dynamically allocated memory
    ~vector() {
        delete[] v;
    }
};

int main() {
    int arr1[] = {1, 2, 3};
    int arr2[] = {4, 5, 6};
    int size = 3;

    vector<int> v1(arr1, size); // Initialize with arr1
    vector<int> v2(arr2, size); // Initialize with arr2

    int result = v1 * v2; // Compute dot product
    cout << "Dot product: " << result << endl;

    return 0;
}

#include<iostream>
using namespace std;
int largestProper(int n)
{
    if(n==0)
    {
         throw "the largest proper divisor is not defined for n=0";
    }
    else if(n==1)
        throw "the largest proper divisor is not defined for n=0";
    else 
    {
        for(int i=n/2;i<1;i++)
        {
            if(n%i==0)
            {
                return i;
            }
        }
    }
}
void process(int n)
{
    try{
        int result=largestProper(n);
        printf("Ans = %d",result);
    }
    catch(const invalid_argument& e)
    {
          cout<<e.what() <<endl; 
    }
}
int main(){
    int n;
    scanf("%d",&n);
    process(n);
}


