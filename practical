#include<iostream>
using namespace std;
class hello{
    int a;
    public:
    hello(){}
    hello(int v){
        a=v;
    }
    int operator+(hello obj)
    {
        int x;
        x=a+obj.a;
        cout<<"Ans="<<x;
        return a+obj.a;
    }
    int operator++(int)
    {
        a++;
        return a;
    }
    int operator++()
    {
       a++;
       return a;
    }
    void  display()
    {
       cout<<"dd:"<<a;
    }
    friend hello operator--(hello &obj);
    friend hello operator--(hello &obj,int);
};
hello operator--(hello &obj) 
{
   return obj.a=--obj.a;
}
hello operator--(hello &obj,int) 
{
   return obj.a=--obj.a;
}
int main()
{
   hello d(5);
   hello c(8);
   c+d;
   
  c++;
  ++c;
   cout<<"After:"<<++c;
   c.display();
   c--;
    c.display();

}



